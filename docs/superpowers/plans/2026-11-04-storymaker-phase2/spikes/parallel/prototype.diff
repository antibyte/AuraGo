+++ b/internal/storymaker/render/parallel_spike_test.go
@@ -0,0 +1,231 @@
+package render
+
+import (
+	"bytes"
+	"context"
+	"crypto/sha256"
+	"encoding/hex"
+	"encoding/json"
+	"fmt"
+	"os"
+	"path/filepath"
+	"runtime"
+	"strconv"
+	"strings"
+	"sync"
+	"testing"
+	"time"
+
+	"github.com/shirou/gopsutil/v4/process"
+)
+
+// Parallel-worker spike (phase 2). Run with AURAGO_RUN_BROWSER_SMOKE=1 AURAGO_PSPIKE=1.
+//   AURAGO_PSPIKE_NS=0,1,2,4      N values; 0 = the serial production loop
+//   AURAGO_PSPIKE_C=8             chunk size
+//   AURAGO_PSPIKE_PRE=1|0         pre-roll on/off (2 frames)
+//   AURAGO_PSPIKE_ENC=host|worker where the PNG is made
+//   AURAGO_PSPIKE_RUNS=2
+//   AURAGO_PSPIKE_HASH=1          decode every frame and hash RGBA (slows the run; for parity only)
+//   AURAGO_PSPIKE_DUMP=1          keep the PNG bytes of every frame on disk
+//   AURAGO_PSPIKE_OUT=<dir>       results.jsonl and hash files go here
+//   AURAGO_PSPIKE_LABEL=<text>
+
+type spyPage struct {
+	browserPage
+	pid int
+}
+
+type memSample struct {
+	Total, Renderer, Browser, GPU, Other int64
+}
+
+func typeRSS(pid int) memSample {
+	var m memSample
+	if pid <= 0 {
+		return m
+	}
+	root, err := process.NewProcess(int32(pid))
+	if err != nil {
+		return m
+	}
+	var walk func(p *process.Process)
+	walk = func(p *process.Process) {
+		if mem, err := p.MemoryInfo(); err == nil && mem != nil {
+			rss := int64(mem.RSS)
+			cmd, _ := p.Cmdline()
+			m.Total += rss
+			switch {
+			case strings.Contains(cmd, "--type=renderer"):
+				m.Renderer += rss
+			case strings.Contains(cmd, "--type=gpu-process"):
+				m.GPU += rss
+			case !strings.Contains(cmd, "--type="):
+				m.Browser += rss
+			default:
+				m.Other += rss
+			}
+		}
+		if kids, err := p.Children(); err == nil {
+			for _, k := range kids {
+				walk(k)
+			}
+		}
+	}
+	walk(root)
+	return m
+}
+
+func TestParallelSpike(t *testing.T) {
+	chrome := browserSmoke(t)
+	if os.Getenv("AURAGO_PSPIKE") != "1" {
+		t.Skip("set AURAGO_PSPIKE=1")
+	}
+	envOr := func(k, d string) string {
+		if v := os.Getenv(k); v != "" {
+			return v
+		}
+		return d
+	}
+	ns := strings.Split(envOr("AURAGO_PSPIKE_NS", "0,1"), ",")
+	chunk, _ := strconv.Atoi(envOr("AURAGO_PSPIKE_C", "8"))
+	pre := envOr("AURAGO_PSPIKE_PRE", "1") == "1"
+	enc := envOr("AURAGO_PSPIKE_ENC", "host")
+	runs, _ := strconv.Atoi(envOr("AURAGO_PSPIKE_RUNS", "2"))
+	doHash := os.Getenv("AURAGO_PSPIKE_HASH") == "1"
+	dump := os.Getenv("AURAGO_PSPIKE_DUMP") == "1"
+	out := envOr("AURAGO_PSPIKE_OUT", t.TempDir())
+	label := envOr("AURAGO_PSPIKE_LABEL", "")
+	_ = os.MkdirAll(out, 0o755)
+
+	for _, nStr := range ns {
+		nW, _ := strconv.Atoi(strings.TrimSpace(nStr))
+		for run := 0; run < runs; run++ {
+			cfg := map[string]any{"N": nW, "C": chunk, "preroll": pre, "enc": enc}
+			cfgJSON, _ := json.Marshal(cfg)
+			tag := fmt.Sprintf("N%d_C%d_pre%v_%s%s_r%d", nW, chunk, pre, enc, label, run)
+
+			var mu sync.Mutex
+			pngSums := map[int]string{}
+			rgba := map[int]string{}
+			arrive := map[int]time.Time{}
+			var first, last time.Time
+			var totalBytes int64
+			observer := func(n int, tr string, data []byte) {
+				now := time.Now()
+				sum := sha256.Sum256(data)
+				var h string
+				if doHash {
+					h = decodedHash(t, tr, data)
+				}
+				mu.Lock()
+				if first.IsZero() {
+					first = now
+				}
+				last = time.Now()
+				totalBytes += int64(len(data))
+				pngSums[n] = hex.EncodeToString(sum[:])
+				if doHash {
+					rgba[n] = h
+				}
+				arrive[n] = now
+				mu.Unlock()
+				if dump {
+					_ = os.WriteFile(filepath.Join(out, tag+"_f"+strconv.Itoa(n)+".png"), data, 0o644)
+				}
+			}
+
+			fx := newRealFixture(t, chrome)
+			fx.deps.UI = patchedUI{FS: fx.deps.UI, edit: func(src []byte) []byte {
+				return bytes.Replace(src, []byte("var TRANSPORTS = ["), append(append([]byte("root.__SM_SPIKE_CFG = "), cfgJSON...), []byte(";\n    var TRANSPORTS = [")...), 1)
+			}}
+			fx.deps.FrameObserver = observer
+			var spy *spyPage
+			var spyMu sync.Mutex
+			fx.deps.OpenPage = func(ctx context.Context, o sessionOptions) (browserPage, error) {
+				p, err := openSession(ctx, o)
+				if err != nil {
+					return nil, err
+				}
+				s := &spyPage{browserPage: p}
+				if ss, ok := p.(*session); ok {
+					s.pid = ss.proc.PID()
+				}
+				spyMu.Lock()
+				spy = s
+				spyMu.Unlock()
+				return s, nil
+			}
+			fx.rebuild(t)
+			fx.loadFirewall(t)
+
+			stop := make(chan struct{})
+			var wg sync.WaitGroup
+			var peak memSample
+			var lastProfile string
+			wg.Add(1)
+			go func() {
+				defer wg.Done()
+				tick := time.NewTicker(300 * time.Millisecond)
+				defer tick.Stop()
+				for {
+					select {
+					case <-stop:
+						return
+					case <-tick.C:
+						spyMu.Lock()
+						s := spy
+						spyMu.Unlock()
+						if s == nil {
+							continue
+						}
+						if m := typeRSS(s.pid); m.Total > peak.Total {
+							peak = m
+						}
+						if st := s.browserPage.Status(context.Background()); strings.Contains(st, `"profile"`) {
+							lastProfile = st
+						}
+					}
+				}
+			}()
+			SpikeAcceptNanos.Store(0)
+			SpikeAcceptCount.Store(0)
+			started := time.Now()
+			job := fx.render(t)
+			elapsed := time.Since(started)
+			close(stop)
+			wg.Wait()
+			if job.Status != StatusSucceeded {
+				t.Fatalf("%s: %+v %+v", tag, job, job.Error)
+			}
+			span := last.Sub(first).Seconds()
+			var prof map[string]any
+			var st struct {
+				Profile map[string]any `json:"profile"`
+			}
+			if json.Unmarshal([]byte(lastProfile), &st) == nil {
+				prof = st.Profile
+			}
+			row := map[string]any{
+				"tag": tag, "n": nW, "c": chunk, "preroll": pre, "enc": enc, "run": run, "frames": job.FramesTotal,
+				"fps_ingest": float64(job.FramesTotal) / span, "ingest_span_s": span, "job_s": elapsed.Seconds(),
+				"avg_png_bytes": totalBytes / int64(max(job.FramesTotal, 1)),
+				"rss_mb_total": peak.Total >> 20, "rss_mb_renderer": peak.Renderer >> 20, "rss_mb_browser": peak.Browser >> 20, "rss_mb_gpu": peak.GPU >> 20, "rss_mb_other": peak.Other >> 20,
+				"cpus": runtime.NumCPU(), "profile": prof, "accept_ms_per_frame": float64(SpikeAcceptNanos.Load()) / 1e6 / float64(max(SpikeAcceptCount.Load(), 1)),
+			}
+			b, _ := json.Marshal(row)
+			t.Logf("%s", b)
+			f, _ := os.OpenFile(filepath.Join(out, "results.jsonl"), os.O_APPEND|os.O_CREATE|os.O_WRONLY, 0o644)
+			f.Write(append(b, '\n'))
+			f.Close()
+			hb, _ := json.Marshal(map[string]any{"png_sha": pngSums, "rgba_sha": rgba})
+			_ = os.WriteFile(filepath.Join(out, "hashes_"+tag+".json"), hb, 0o644)
+			// the arrival log of frame n lets the analysis see stalls
+			ab := map[int]float64{}
+			for n, ts := range arrive {
+				ab[n] = ts.Sub(first).Seconds()
+			}
+			abb, _ := json.Marshal(ab)
+			_ = os.WriteFile(filepath.Join(out, "arrive_"+tag+".json"), abb, 0o644)
+		}
+	}
+}
