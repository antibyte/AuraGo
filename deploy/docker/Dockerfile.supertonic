FROM python:3.12-slim

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PIP_NO_CACHE_DIR=1

RUN apt-get update \
    && apt-get install -y --no-install-recommends ca-certificates libsndfile1 \
    && rm -rf /var/lib/apt/lists/*

RUN pip install "supertonic[serve]==1.3.1"

RUN groupadd --gid 1001 supertonic \
    && useradd --uid 1001 --gid 1001 --create-home --home-dir /home/supertonic --shell /usr/sbin/nologin supertonic \
    && mkdir -p /home/supertonic/.cache \
    && chown -R supertonic:supertonic /home/supertonic

ENV HOME=/home/supertonic

EXPOSE 7788

USER supertonic

CMD ["supertonic", "serve", "--host", "0.0.0.0", "--port", "7788", "--model", "supertonic-3"]
