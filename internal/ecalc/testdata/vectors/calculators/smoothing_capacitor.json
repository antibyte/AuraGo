    {"choices": {"rect": "full"}, "values": {"i": 0.5, "f": 60, "dv": 0.5, "c": 0.008333333333333333, "fr": 120}, "ref": "hand: C = 0.5 / (2 * 60 * 0.5) = 0.5 / 60 = 8.3333 mF; f_r = 120 Hz"},
    {"choices": {"rect": "half"}, "values": {"i": 1, "f": 50, "dv": 1, "c": 0.02, "fr": 50}, "ref": "hand: C = 1 / (1 * 50 * 1) = 0.02 F (20 mF); f_r = 50 Hz"},
    {"choices": {"rect": "half"}, "values": {"i": 0.2, "f": 60, "dv": 2, "c": 0.0016666666666666668, "fr": 60}, "ref": "hand: C = 0.2 / (1 * 60 * 2) = 0.2 / 120 = 1.6667 mF; f_r = 60 Hz"}
