+
+// volumeView is the JSON shape of a volume. expires_at is empty for a
+// persistent volume.
+func volumeView(m *VolumeMeta, used int64, files int) map[string]any {
+	expires := ""
+	if !m.Persistent {
+		expires = m.ExpiresAt.UTC().Format(time.RFC3339)
+	}
+	return map[string]any{
+		"id": m.ID, "created_at": m.CreatedAt, "expires_at": expires,
+		"quota_mb": m.QuotaMB, "used_bytes": used, "files": files,
+		"persistent": m.Persistent, "locked": m.Locked,
+	}
+}
+
+// handleUpdateVolume changes a volume's retention: extend the TTL, make it
+// persistent, or lock it against deletion.
+func (s *Server) handleUpdateVolume(w http.ResponseWriter, r *http.Request) {
+	var req struct {
+		TTLSeconds *int  `json:"ttl_seconds"`
+		Persistent *bool `json:"persistent"`
+		Locked     *bool `json:"locked"`
+	}
+	if err := json.NewDecoder(r.Body).Decode(&req); err != nil {
+		writeJSON(w, http.StatusBadRequest, map[string]any{"error": "invalid JSON: " + err.Error()})
+		return
+	}
+	if req.TTLSeconds == nil && req.Persistent == nil && req.Locked == nil {
+		writeJSON(w, http.StatusBadRequest, map[string]any{"error": "ttl_seconds, persistent or locked required"})
+		return
+	}
+	m, err := s.storage.Get(r.PathValue("id"))
+	if err != nil {
+		writeJSON(w, http.StatusNotFound, map[string]any{"error": "no such volume (it may have expired)"})
+		return
+	}
+	if req.Persistent != nil && *req.Persistent {
+		m.Persistent = true
+		m.ExpiresAt = time.Now().Add(persistentSpan)
+	} else if req.Persistent != nil || req.TTLSeconds != nil {
+		ttl := 0
+		if req.TTLSeconds != nil {
+			ttl = *req.TTLSeconds
+		}
+		m.Persistent = false
+		m.ExpiresAt = time.Now().Add(s.volumeTTL(ttl))
+	}
+	if req.Locked != nil {
+		m.Locked = *req.Locked
+	}
+	if err := s.storage.Update(m); err != nil {
+		writeJSON(w, http.StatusBadGateway, map[string]any{"error": "couldn't update the volume"})
+		return
+	}
+	files, used, err := s.storage.ListFiles(m.ID)
+	if err != nil {
+		writeJSON(w, http.StatusBadGateway, map[string]any{"error": "couldn't list volume files"})
+		return
+	}
+	writeJSON(w, http.StatusOK, volumeView(m, used, len(files)))
+}
+
+// volumeLocked answers 423 and returns true when the volume is locked.
+func (s *Server) volumeLocked(w http.ResponseWriter, id string) bool {
+	if m, err := s.storage.Get(id); err == nil && m.Locked {
+		writeJSON(w, http.StatusLocked, map[string]any{"error": "volume is locked"})
+		return true
+	}
+	return false
 }
 
