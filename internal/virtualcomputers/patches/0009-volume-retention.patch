-	// Cap the stream at the volume quota so a runaway /root can't blow past it.
-	limited := io.LimitReader(conn, s.storage.quotaBytes)
-	if err := s.storage.PutFile(volumeID, volumeSnapshot, limited, -1); err != nil {
+	// Stream into a partial object, read one byte past the quota so an
+	// oversized workspace is detected instead of silently truncated, and only
+	// replace the previous snapshot once the new one is complete.
+	partial := volumeSnapshot + ".partial"
+	counter := &countingReader{r: io.LimitReader(conn, s.storage.quotaBytes+1)}
+	if err := s.storage.PutFile(volumeID, partial, counter, -1); err != nil {
+		s.storage.DeleteFile(volumeID, partial)
+		writeJSON(w, http.StatusBadGateway, map[string]any{"error": "couldn't save to the volume"})
+		return
+	}
+	if counter.n > s.storage.quotaBytes {
+		s.storage.DeleteFile(volumeID, partial)
+		writeJSON(w, http.StatusRequestEntityTooLarge, map[string]any{"error": "the workspace is larger than the volume quota"})
+		return
+	}
+	if err := s.storage.Promote(volumeID, partial, volumeSnapshot); err != nil {
+		s.storage.DeleteFile(volumeID, partial)
 		writeJSON(w, http.StatusBadGateway, map[string]any{"error": "couldn't save to the volume"})
 		return
 	}
 	writeJSON(w, http.StatusOK, map[string]any{"ok": true, "volume": volumeID})
 }
+
+// countingReader counts the bytes read through it.
+type countingReader struct {
+	r io.Reader
+	n int64
+}
+
+func (c *countingReader) Read(p []byte) (int, error) {
+	n, err := c.r.Read(p)
+	c.n += int64(n)
+	return n, err
+}
