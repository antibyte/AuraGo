+// Promote moves an object inside a volume with a server-side copy, so a new
+// file only replaces the old one once it has been stored completely.
+func (s *Storage) Promote(id, from, to string) error {
+	ctx, cancel := context.WithTimeout(context.Background(), 5*time.Minute)
+	defer cancel()
+	_, err := s.client.CopyObject(ctx,
+		minio.CopyDestOptions{Bucket: s.bucket, Object: fileKey(id, to)},
+		minio.CopySrcOptions{Bucket: s.bucket, Object: fileKey(id, from)})
+	if err != nil {
+		return err
+	}
+	return s.DeleteFile(id, from)
+}
