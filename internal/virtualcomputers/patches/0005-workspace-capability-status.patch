 }
 
+var workspaceAssetFingerprint = "development"
+
+func (s *Server) handleWorkspaceCapabilities(w http.ResponseWriter, _ *http.Request) {
+	writeJSON(w, http.StatusOK, map[string]any{
+		"protocol_version": "aurago.workspace.v1",
+		"asset_fingerprint": workspaceAssetFingerprint,
+	})
+}
+
 // workspaceAuth intentionally rejects the query-token compatibility path used
 // by legacy browser channels. Workspace control is host-to-host only and keeps
