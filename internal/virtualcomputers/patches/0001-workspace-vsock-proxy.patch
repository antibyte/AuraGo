index 0000000..57bd734
--- /dev/null
+++ b/boringd/workspace.go
@@ -0,0 +1,150 @@
+package main
+
+import (
+	"context"
+	"errors"
+	"net"
+	"net/http"
+	"sync"
+	"time"
+
+	"github.com/gorilla/websocket"
+)
+
+const (
+	workspaceGuestPort            = 7331
+	workspaceMaxMessage           = 8 << 20
+	workspaceMaxOperations        = 32
+	workspaceMaxMachineOperations = 4
+	workspaceWriteTimeout         = 3 * time.Second
+)
+
+type workspaceOperationLimiter struct {
+	mu        sync.Mutex
+	total     int
+	byMachine map[string]int
+}
+
+var workspaceOperations = &workspaceOperationLimiter{byMachine: make(map[string]int)}
+
+func (l *workspaceOperationLimiter) tryAcquire(machineID string) (func(), bool) {
+	l.mu.Lock()
+	if l.total >= workspaceMaxOperations || l.byMachine[machineID] >= workspaceMaxMachineOperations {
+		l.mu.Unlock()
+		return nil, false
+	}
+	l.total++
+	l.byMachine[machineID]++
+	l.mu.Unlock()
+	var once sync.Once
+	return func() {
+		once.Do(func() {
+			l.mu.Lock()
+			l.total--
+			l.byMachine[machineID]--
+			if l.byMachine[machineID] == 0 {
+				delete(l.byMachine, machineID)
+			}
+			l.mu.Unlock()
+		})
+	}, true
+}
+
+var workspaceUpgrader = websocket.Upgrader{
+	ReadBufferSize:  32 << 10,
+	WriteBufferSize: 32 << 10,
+	CheckOrigin:     func(*http.Request) bool { return true },
+}
+
+// workspaceAuth intentionally rejects the query-token compatibility path used
+// by legacy browser channels. Workspace control is host-to-host only and keeps
+// the boringd token in the Authorization header.
+func (s *Server) workspaceAuth(next http.Handler) http.Handler {
+	return http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
+		if r.URL.Query().Get("token") != "" {
+			http.Error(w, "query token is not accepted", http.StatusUnauthorized)
+			return
+		}
+		s.auth(next).ServeHTTP(w, r)
+	})
+}
+
+// handleWorkspace authenticates at boringd and bridges WebSocket frames to the
+// AuraGo workspace agent over the selected machine's private Firecracker vsock.
+func (s *Server) handleWorkspace(w http.ResponseWriter, r *http.Request) {
+	machineID := r.PathValue("id")
+	release, ok := workspaceOperations.tryAcquire(machineID)
+	if !ok {
+		w.Header().Set("Retry-After", "1")
+		http.Error(w, "workspace operation capacity reached", http.StatusTooManyRequests)
+		return
+	}
+	defer release()
+	guestConn, err := s.mgr.DialVsock(machineID, workspaceGuestPort)
+	if errors.Is(err, ErrNotFound) {
+		http.Error(w, "machine not found", http.StatusNotFound)
+		return
+	}
+	if err != nil {
+		http.Error(w, "workspace agent unavailable", http.StatusUpgradeRequired)
+		return
+	}
+	used := false
+	dialer := websocket.Dialer{
+		HandshakeTimeout: 5 * time.Second,
+		ReadBufferSize:   32 << 10,
+		WriteBufferSize:  32 << 10,
+		NetDialContext: func(context.Context, string, string) (net.Conn, error) {
+			if used {
+				return nil, errors.New("workspace vsock connection already used")
+			}
+			used = true
+			return guestConn, nil
+		},
+	}
+	guestWS, response, err := dialer.DialContext(r.Context(), "ws://workspace/workspace", nil)
+	if err != nil {
+		_ = guestConn.Close()
+		if response != nil && response.Body != nil {
+			_ = response.Body.Close()
+		}
+		http.Error(w, "workspace agent handshake failed", http.StatusUpgradeRequired)
+		return
+	}
+	defer guestWS.Close()
+	clientWS, err := workspaceUpgrader.Upgrade(w, r, nil)
+	if err != nil {
+		return
+	}
+	defer clientWS.Close()
+	guestWS.SetReadLimit(workspaceMaxMessage)
+	clientWS.SetReadLimit(workspaceMaxMessage)
+
+	var once sync.Once
+	done := make(chan struct{})
+	bridge := func(dst, src *websocket.Conn) {
+		defer once.Do(func() { close(done) })
+		for {
+			messageType, payload, err := src.ReadMessage()
+			if err != nil {
+				return
+			}
+			if len(payload) > workspaceMaxMessage {
+				return
+			}
+			_ = dst.SetWriteDeadline(time.Now().Add(workspaceWriteTimeout))
+			if err := dst.WriteMessage(messageType, payload); err != nil {
+				return
+			}
+			_ = dst.SetWriteDeadline(time.Time{})
+		}
+	}
+	go bridge(guestWS, clientWS)
+	go bridge(clientWS, guestWS)
+	select {
+	case <-done:
+	case <-r.Context().Done():
+	}
+	_ = clientWS.WriteControl(websocket.CloseMessage, websocket.FormatCloseMessage(websocket.CloseNormalClosure, ""), time.Now().Add(time.Second))
+	_ = guestWS.WriteControl(websocket.CloseMessage, websocket.FormatCloseMessage(websocket.CloseNormalClosure, ""), time.Now().Add(time.Second))
+}
