{
  "id": "esp32-3248s035c",
  "label": "CYD 3.5\" (ESP32-3248S035C, capacitive)",
  "status": "community",
  "source": "https://github.com/rzeldent/platformio-espressif32-sunton/blob/main/esp32-3248S035C.json",
  "chip": "esp32",
  "flash_mb": 4,
  "psram": false,
  "pio": {
    "board": "esp32dev"
  },
  "display": {
    "driver": "ST7796",
    "bus": "spi",
    "width": 480,
    "height": 320,
    "native_orientation": "landscape",
    "invert": false,
    "bgr": false,
    "pins": { "sclk": 14, "mosi": 13, "miso": 12, "cs": 15, "dc": 2, "rst": -1, "bl": 27 },
    "hz": 40000000,
    "bl_pwm": true,
    "offset_rotation": 1
  },
  "touch": {
    "driver": "GT911",
    "bus": "i2c",
    "pins": { "sda": 33, "scl": 32, "int": 21, "rst": 25 },
    "i2c_addr": 93,
    "needs_calibration": false
  },
  "extras": {
    "rgb_led": { "r": 4, "g": 16, "b": 17, "active_low": true },
    "ldr": 34,
    "speaker": 26,
    "sd_cs": 5,
    "boot_button": 0
  },
  "lvgl": { "draw_buffer_lines": 24, "double_buffer": false }
}
