{
  "id": "esp32-2432s024r",
  "label": "CYD 2.4\" (ESP32-2432S024R, resistive)",
  "status": "community",
  "source": "https://github.com/rzeldent/platformio-espressif32-sunton/blob/main/esp32-2432S024R.json",
  "chip": "esp32",
  "flash_mb": 4,
  "psram": false,
  "pio": {
    "board": "esp32dev"
  },
  "display": {
    "driver": "ILI9341",
    "bus": "spi",
    "width": 320,
    "height": 240,
    "native_orientation": "landscape",
    "invert": false,
    "bgr": false,
    "pins": { "sclk": 14, "mosi": 13, "miso": 12, "cs": 15, "dc": 2, "rst": -1, "bl": 27 },
    "hz": 40000000,
    "bl_pwm": true,
    "offset_rotation": 1
  },
  "touch": {
    "driver": "XPT2046",
    "bus": "spi",
    "pins": { "sclk": 14, "mosi": 13, "miso": 12, "cs": 33, "irq": 36 },
    "calibration": { "x_min": 290, "x_max": 3670, "y_min": 230, "y_max": 3860 },
    "needs_calibration": true
  },
  "extras": {
    "rgb_led": { "r": 4, "g": 16, "b": 17, "active_low": true },
    "ldr": 34,
    "speaker": 26,
    "sd_cs": 5,
    "boot_button": 0
  },
  "lvgl": { "draw_buffer_lines": 24, "double_buffer": false }
}
