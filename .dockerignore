# Build artifacts
assets/web/
bin/
deploy/*
!deploy/
!deploy/docker/
!deploy/docker/**
!deploy/phonon/
!deploy/phonon/model/
!deploy/phonon/model/config.json
!deploy/phonon/model/tokenizer.json
!deploy/phonon/model/model.q8.gguf
!deploy/phonon/model/default-voice.safetensors
!deploy/phonon/voices/
!deploy/phonon/voices/*.safetensors
!deploy/phonon/voices.jsonl
!deploy/phonon/runtime/
!deploy/phonon/runtime/linux_amd64/
!deploy/phonon/runtime/linux_amd64/ptts
!deploy/phonon/runtime/linux_arm64/
!deploy/phonon/runtime/linux_arm64/ptts
*.bat
*.sh
!docker-entrypoint.sh

# Git / IDE
.git/
.gitignore
.vscode/
.idea/
.DS_Store
Thumbs.db

# Developer-only config (contains real credentials – keep out of image)
.env
.env.*
config_debug.yaml
config.yaml
config_*.yaml
!config_template.yaml

# Runtime data (should be mounted as volumes, not baked in)
data/
log/
agent_workspace/workdir/
agent_workspace/tools/

# Reports (may contain sensitive data)
reports/

# Disposable working files
disposable/

# Local secrets, worktrees and tool state (never part of an image)
secrets/
.worktrees/
.claude/
.kilo/
.kilocode/
.gitnexus/

# Sensitive skill credentials
agent_workspace/skills/token.json
agent_workspace/skills/client_secret.json
agent_workspace/skills/client_secrets.json

# Misc
*.lock
*.md
!README.md
!documentation/phonon.md
!**/THIRD_PARTY_NOTICES.md
!**/LICENSE*
