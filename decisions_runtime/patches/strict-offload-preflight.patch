+struct mtmd_device_memory_usage mtmd_get_context_device_memory_usage(const mtmd_context * ctx, ggml_backend_dev_t selected_device) {
+    mtmd_device_memory_usage usage{};
+    if (!ctx || !selected_device) return usage;
+    auto collect = [&](const clip_ctx * clip) {
+        if (!clip) return;
+        for (const auto & [dev, bytes] : clip_get_weight_mem_usage(clip)) {
+            if (dev == selected_device) usage.selected_weight_bytes += bytes;
+            else usage.other_weight_bytes += bytes;
+            if (dev && ggml_backend_dev_type(dev) == GGML_BACKEND_DEVICE_TYPE_CPU) usage.cpu_weight_bytes += bytes;
+            else if (dev != selected_device) usage.non_cpu_other_weight_bytes += bytes;
+        }
+        for (const auto & [dev, bytes] : clip_get_compute_mem_usage(clip)) {
+            if (dev == selected_device) usage.selected_compute_bytes += bytes;
+            else usage.other_compute_bytes += bytes;
+            if (dev && ggml_backend_dev_type(dev) == GGML_BACKEND_DEVICE_TYPE_CPU) usage.cpu_compute_bytes += bytes;
+            else if (dev != selected_device) usage.non_cpu_other_compute_bytes += bytes;
+        }
+    };
+    collect(ctx->ctx_v);
+    collect(ctx->ctx_a);
+    collect(ctx->ctx_gen_a);
+    return usage;
+}
+
 void mtmd_free(mtmd_context * ctx) {
     delete ctx;
 }
