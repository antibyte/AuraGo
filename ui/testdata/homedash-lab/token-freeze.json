    ".hd-widget[data-hd-family=\"instrument\"][data-hd-type=\"sensor\"] .hd-body > .hd-seg7": {
      "--hd-i-seg-h": "min(18cqmin, calc((var(--hd-body-w) - 36px) / 4))"
    },
    "@container hd-widget (aspect-ratio >= 1.6) :: .hd-widget[data-hd-family=\"instrument\"][data-hd-type=\"sensor\"] .hd-body > .hd-seg7": {
      "--hd-i-seg-h": "calc(22cqmin * 0.72)"
    },
    ".hd-root[data-hd-corners=\"square\"] .hd-widget[data-hd-family=\"instrument\"]": {
      "--hd-radius-card": "0px",
      "--hd-radius-control": "0px"
    }
  }
}
