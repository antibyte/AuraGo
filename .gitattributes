# Normalize line endings: LF in repository, platform-native on checkout
* text=auto
.gitattributes text eol=lf

# Force LF for all shell scripts regardless of OS
*.sh    text eol=lf
*.bash  text eol=lf
docker-entrypoint.sh text eol=lf

# Go source files use LF
*.go    text eol=lf

# Markdown
*.md    text eol=lf
*.yaml  text eol=lf
*.yml   text eol=lf
*.json  text eol=lf

# Generated frontend bundles are written with LF by scripts/build-ui-bundles.js.
ui/css/*.bundle.css text eol=lf
ui/js/chat/bundles/*.js text eol=lf
ui/js/chat/main.js text eol=lf
ui/js/desktop/bundles/*.js text eol=lf
ui/js/desktop/aura-desktop-sdk.js text eol=lf

# Reproducible icon output and its pinned import inputs.
assets/desktop-icon-themes/** text=auto eol=lf
ui/img/tela/** text=auto eol=lf
ui/img/candy/** text=auto eol=lf
ui/img/fluent/** text=auto eol=lf
ui/img/buuf-nestort/** text=auto eol=lf
licences/texts/CC-BY-NC-SA-2.5.txt text eol=lf -whitespace
ui/img/buuf-nestort/LICENSE.txt -whitespace

# Preserve generated template literals and upstream license text byte-for-byte.
ui/js/vendor/** text=auto eol=lf -whitespace
internal/desktop/bundled_apps/nasscad/** text=auto eol=lf -whitespace
internal/gamemaker/runtime/three-*.min.js text eol=lf -whitespace

# CYD Creator: the embedded device template, the generator's reference and
# golden trees and the builder scripts are compared byte for byte or run in
# Linux containers, so they keep LF on every platform.
internal/cydcreator/template/** text=auto eol=lf
internal/cydcreator/testdata/** text=auto eol=lf
internal/cydcreator/testdata/**/partitions.csv text eol=lf -whitespace
deploy/docker/cyd-builder/** text=auto eol=lf
deploy/docker/Dockerfile.cyd-builder text eol=lf
internal/server/testdata/cyd_builder_stub/** text eol=lf

# Binaries — never convert
*.exe   binary
bin/aurago_linux        binary
bin/config-merger_linux binary
bin/aurago_linux_arm64        binary
bin/config-merger_linux_arm64 binary

# ZIM archives (Local Wikipedia test fixtures)
*.zim   binary

# Local Wikipedia fixture generators: article texts must stay byte-stable across checkouts
scripts/localwiki/fixtures/*.py  text eol=lf
scripts/localwiki/fixtures/*.txt text eol=lf

# The Decisions safety patch is verified by its exact SHA-256 during builds.
# Blank unified-diff context lines retain their required leading space.
decisions_runtime/patches/*.patch text eol=lf whitespace=-blank-at-eol
